{
  "name": "deerprint",
  "version": "3.0.8",
  "description": "DeerPrint - App desktop moderno e profissional para captura de tela, anotações de precisão e produtividade",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "node scripts/build.js",
    "build": "node scripts/build.js",
    "release": "node scripts/publish-tag.js",
    "publish:github": "electron-builder --win --publish always"
  },
  "keywords": [
    "deerprint",
    "screenshot",
    "screen-capture",
    "electron",
    "editor",
    "annotation"
  ],
  "author": "",
  "license": "MIT",
  "build": {
    "appId": "com.deerprint.app",
    "productName": "DeerPrint",
    "publish": {
      "provider": "github",
      "owner": "Fulviotanure",
      "repo": "deerprint"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/icon.ico"
    },
    "asarUnpack": [
      "src/main/native/**/*"
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "DeerPrint",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "runAfterFinish": true,
      "installerIcon": "src/assets/icon.ico",
      "uninstallerIcon": "src/assets/icon.ico",
      "uninstallDisplayName": "${productName}",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    }
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
